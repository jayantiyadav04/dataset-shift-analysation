# Stable text bytes for configuration and dependency-lock hashes on every checkout.
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.npz binary
*.npy binary
*.joblib binary

# Published evidence must retain exact sealed bytes, including CSV line endings.
reports/study/** -text whitespace=cr-at-eol
reports/workbench/** -text whitespace=cr-at-eol
